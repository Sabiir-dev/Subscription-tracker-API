NODE_ENV=development
PORT=5500
SERVER_URL=http://localhost:5500

DB_URI=mongodb://127.0.0.1:27017/subdub
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

ARCJET_ENV=development
ARCJET_KEY=

# Local development: true enables the QStash Workflow development server.
# In production, set this to false and use the hosted QStash credentials and keys.
QSTASH_DEV=true
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Gmail App Password for the sender configured in config/nodemailer.js
EMAIL_PASSWORD=
